---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts.ts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Welcome to Modern Heritage</h1>
				<p class="lead">
					Celebrating the slow-pour ritual of coffee culture through a sophisticated visual language.
				</p>
				<div class="cta">
					<a href="/blog" class="button-primary">Read the Blog</a>
				</div>
			</section>

			<hr />

			<section>
				<h2>Editorial Philosophy</h2>
				<p>
					This blog is an editorial atmosphere that bridges the gap between a 19th-century Viennese coffee house and a high-end modern digital publication. Our brand personality is authoritative yet inviting.
				</p>
				<p>
					We prioritize a literary aesthetic with <strong>Newsreader</strong> serifs and <strong>Work Sans</strong> for legibility. Large body text and generous line heights are essential to maintain our "slow-read" philosophy.
				</p>
			</section>

			<section>
				<h2>Latest Discussions</h2>
				<p>
					Explore our latest articles on coffee production, artisanal roasting, and brewing methods.
				</p>
				<ul>
					<li>Edit this page in <code>src/pages/index.astro</code></li>
					<li>Add your name to the footer in <code>src/components/Footer.astro</code></li>
					<li>Check out the included blog posts in <code>src/content/blog/</code></li>
				</ul>
			</section>
		</main>
		<Footer />
		<style>
			.hero {
				text-align: center;
				padding: var(--stack-lg) 0;
			}
			.lead {
				font-size: 1.25rem;
				color: var(--on-surface-variant);
				max-width: 600px;
				margin: 0 auto var(--stack-md);
			}
			.cta {
				margin-top: var(--stack-md);
			}
			section {
				margin-bottom: var(--stack-lg);
			}
		</style>
	</body>
</html>
