---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Heritage Coffee Journal">
	<div class="max-w-7xl mx-auto px-6 py-12 space-y-16">
		<!-- Hero Featured Story -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
			<div class="lg:col-span-7 relative group overflow-hidden rounded-lg shadow-xl">
				<img 
					class="w-full h-[600px] object-cover transition-transform duration-700 group-hover:scale-105" 
					src="https://lh3.googleusercontent.com/aida-public/AB6AXuC07OiQJ7BWUJ0Vv2PlQXiCifWG1xaCK6UiM0lWAJdIO5L0OB3ECitiSJSe_0OHqDOYPanF0jN-NqJdSOIki5PTed6hQPFxQZwlVLZ9IohbjvSFB58VwhbEh963OjR24rSG2m0Tck96i5j0ZbEa_Cei_6IR3pUPOzx-PWOA3I06ABg1rBqpi_wJqpPhrBVZP78FTquYgkMmD0IYywPO64jvk_l6wg88X-NSrCimoI5JjK7tfsOUvibUs2ch-cC8uvu576tBey-QA_E" 
					alt="Vintage coffee craft"
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
				<div class="absolute bottom-0 left-0 p-8 text-white">
					<span class="text-xs uppercase bg-stone-700 px-3 py-1 rounded-full mb-4 inline-block tracking-widest font-bold">The Bean</span>
					<h2 class="text-5xl font-serif font-bold mb-4 leading-tight">The Lost Heirloom: Rediscovering Yemen's Ancient Mocha Variety</h2>
					<p class="text-lg text-stone-200 max-w-xl mb-6">A journey into the high-altitude terraces where the world's most storied coffee beans are making a miraculous return to the global stage.</p>
					<button class="bg-white text-primary px-8 py-3 text-xs font-bold uppercase tracking-widest rounded shadow-lg hover:bg-stone-100 transition-colors">Read the Journal</button>
				</div>
			</div>
			<div class="lg:col-span-5 space-y-8">
				<div class="border-b border-stone-200 pb-8">
					<h3 class="text-2xl font-serif font-semibold italic mb-4 text-primary">Brew Metrics</h3>
					<div class="grid grid-cols-3 gap-4">
						<div class="bg-surface-container p-4 rounded text-center">
							<span class="text-[10px] text-on-surface-variant block uppercase font-bold tracking-widest mb-1">Roast</span>
							<span class="text-sm text-primary font-bold">Medium-Dark</span>
						</div>
						<div class="bg-surface-container p-4 rounded text-center">
							<span class="text-[10px] text-on-surface-variant block uppercase font-bold tracking-widest mb-1">Origin</span>
							<span class="text-sm text-primary font-bold">Yemen</span>
						</div>
						<div class="bg-surface-container p-4 rounded text-center">
							<span class="text-[10px] text-on-surface-variant block uppercase font-bold tracking-widest mb-1">Method</span>
							<span class="text-sm text-primary font-bold">Syphon</span>
						</div>
					</div>
				</div>
				<div class="space-y-6">
					<h4 class="text-xs text-outline tracking-[0.2em] uppercase font-bold">Trending Conversations</h4>
					<ul class="space-y-6">
						<li class="flex gap-4 group cursor-pointer">
							<span class="text-on-tertiary-container font-serif text-3xl italic opacity-50">01</span>
							<div>
								<h5 class="text-xl font-serif font-semibold leading-tight group-hover:text-amber-700 transition-colors">The Physics of the Perfect Pour Over</h5>
								<p class="text-stone-500 text-sm mt-1">Culture • 4 min read</p>
							</div>
						</li>
						<li class="flex gap-4 group cursor-pointer">
							<span class="text-on-tertiary-container font-serif text-3xl italic opacity-50">02</span>
							<div>
								<h5 class="text-xl font-serif font-semibold leading-tight group-hover:text-amber-700 transition-colors">Viennese Pastry & Dark Roasts</h5>
								<p class="text-stone-500 text-sm mt-1">Recipes • 8 min read</p>
							</div>
						</li>
						<li class="flex gap-4 group cursor-pointer">
							<span class="text-on-tertiary-container font-serif text-3xl italic opacity-50">03</span>
							<div>
								<h5 class="text-xl font-serif font-semibold leading-tight group-hover:text-amber-700 transition-colors">The 1890 Coffee House Revival</h5>
								<p class="text-stone-500 text-sm mt-1">History • 12 min read</p>
							</div>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Lateat Dispatches -->
		<section class="space-y-8">
			<div class="flex justify-between items-end border-b border-primary/10 pb-4">
				<h2 class="text-3xl font-serif font-semibold">Latest Dispatches</h2>
				<a href="#" class="text-xs text-primary uppercase font-bold border-b border-primary tracking-widest">Browse All Stories</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-4 gap-6">
				<div class="md:col-span-2 bg-surface-container-low p-6 rounded-lg border border-outline-variant/30 flex flex-col justify-between group cursor-pointer">
					<div>
						<img class="w-full h-64 object-cover rounded mb-6 group-hover:opacity-90 transition-opacity" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB1mofFk4Hhx3nQOjSTYr6zoQgMnCJExF5L1Lq6qOn_xDRJTU7OiCSSnnZTRATA54jTldN3y_dTn67rWxc27buoeayQ82WoII1RZHq0KzottRos1xdSIACBWGK-ZskpWjg-xm4PTljyKcsc2uKF3KfWBSmQRZEgljEWy88k8GgYy_hB6wKru6Xl-c452Ff3raeCOd7XL5LLMVyj5x2esXPnuqQEQBnkmstxXOVTExwkXU7unrPEt-ALDP7Eh6fQXFe2DeEKsXD8mFM" alt="Pour over ritual" />
						<span class="text-xs text-primary uppercase tracking-[0.2em] font-bold block mb-2">Brewing</span>
						<h3 class="text-3xl font-serif font-semibold mb-4 leading-tight">Precision & Patience: The Hario V60 Masterclass</h3>
						<p class="text-on-surface-variant text-sm leading-relaxed">Mastering the spiral pour requires more than just a steady hand; it demands an understanding of fluid dynamics and thermal mass.</p>
					</div>
					<div class="mt-8 pt-4 border-t border-outline-variant/20 flex items-center gap-3">
						<span class="material-symbols-outlined text-primary">history_edu</span>
						<span class="text-xs italic font-medium">By Julian Vane</span>
					</div>
				</div>
				<div class="space-y-6 flex flex-col">
					<div class="bg-surface-container-highest p-6 rounded-lg flex-1 flex flex-col justify-center text-center group cursor-pointer border border-outline-variant/30">
						<span class="material-symbols-outlined text-4xl mb-4 text-primary">eco</span>
						<h4 class="text-xl font-serif font-bold mb-2">The Sustainable Bean</h4>
						<p class="text-sm text-on-surface-variant mb-4">How regenerative farming is saving the Arabica belt.</p>
						<span class="text-xs text-primary uppercase font-bold border-b border-primary mx-auto tracking-widest">Explore Origins</span>
					</div>
					<div class="bg-white p-6 rounded-lg border border-outline-variant/30 flex-1 group cursor-pointer">
						<img class="w-full h-32 object-cover rounded mb-4" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCJi6X1XCGgk7ik-vBiUIwHxt8YxAWZM23lCgjehb9O8kIONKOLgv1rtv24KbG87rgNmi7Y5zJNoRm27hFsIYyn2XI-yQf2qktQh4X3WOeE3A2ENZs693qOiEQ8WNUI51LDIq247_w9jU6KdhtWWCw-hPkL28XRBZdPHetelc_nidk7SMFENXBDEp-pE8K9pXi20vmS88cKZNXfTAQHn2hEZe9ZOguIDwgZJL2I7IH0f_2_PQBIVJUtxpu8CIAaOaBwCLTvdkeYk5I" alt="Grinder guide" />
						<h4 class="text-lg font-serif font-bold text-primary">The 2024 Grinder Guide</h4>
						<p class="text-sm text-on-surface-variant">Manual vs. Electric for the home connoisseur.</p>
					</div>
				</div>
				<div class="bg-primary text-white p-8 rounded-lg flex flex-col justify-between shadow-xl">
					<div>
						<span class="material-symbols-outlined text-[#aa9084] text-5xl mb-6">coffee_maker</span>
						<h3 class="text-2xl font-serif font-bold mb-4 leading-tight text-stone-100">The Ritual of the Chemex</h3>
						<p class="text-sm text-stone-300 leading-relaxed">Clean, bright, and complex. Why this glass vessel remains the architect's favorite way to wake up.</p>
					</div>
					<a href="#" class="mt-8 flex items-center gap-2 text-xs uppercase font-bold tracking-widest text-[#aa9084] hover:text-white transition-colors">
						Learn the technique <span class="material-symbols-outlined text-sm">arrow_forward</span>
					</a>
				</div>
			</div>
		</section>

		<!-- Newsletter -->
		<section class="bg-surface-container-high py-16 px-8 rounded-xl text-center relative overflow-hidden border border-outline-variant/20">
			<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-5 pointer-events-none">
				<span class="material-symbols-outlined text-[400px]">coffee</span>
			</div>
			<div class="max-w-2xl mx-auto relative z-10">
				<h2 class="text-5xl font-serif font-bold mb-4 italic text-primary">The Sunday Roast</h2>
				<p class="text-lg text-on-surface-variant mb-8 italic">Join 45,000 coffee enthusiasts for our weekly long-form essay on culture, bean origins, and brewing science. No spam, just pure craft.</p>
				<form class="flex flex-col md:flex-row gap-4 max-w-lg mx-auto">
					<input class="flex-grow bg-white border-none focus:ring-2 focus:ring-primary p-4 rounded shadow-inner" placeholder="Your email address" type="email" />
					<button class="bg-primary text-white px-8 py-4 text-xs font-bold uppercase tracking-widest rounded shadow-lg hover:bg-stone-800 transition-all">Subscribe</button>
				</form>
				<p class="text-[10px] text-stone-500 mt-8 uppercase tracking-[0.3em] font-bold">Established in Vienna, 1890. Curated for the modern palate.</p>
			</div>
		</section>

		<!-- Cultural Spotlight -->
		<section class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center pt-8">
			<div class="order-2 md:order-1 relative group">
				<img class="rounded-lg shadow-2xl transition-transform duration-700 group-hover:scale-[1.02]" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCumEB4tKwB-FR8_ZiyXiV5QDy5XPm4htZc2D433dsx_UWAWiJWY_C0E3qM_48FMe1Nyb7WZZx1WThqmwCwvNZSaqSs7J839CzzWE2xLNs2bru5zBEILqY2ahU40LclBe0ubIPkJpwUCNU2kWOHd7zwe9CrUc_PBj1sQT7CkCkFziQ_UFMQ5blO3cIWUV95p0uy4M6N4o_-Xdcq1MZyF_ta57zrel3Uu6SDg6_xOA59s4qZoFjorX-CJhHTbFz1CwM8yylJyK7Elng" alt="Classic European Cafe" />
				<div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-lg"></div>
			</div>
			<div class="order-1 md:order-2 space-y-6">
				<span class="text-xs text-on-tertiary-container uppercase tracking-widest font-bold">Culture Spotlight</span>
				<h2 class="text-4xl font-serif font-bold text-primary leading-tight">The Architecture of Stillness: Why We Visit Cafés</h2>
				<p class="text-lg text-on-surface-variant italic border-l-2 border-amber-600 pl-4">"The café is a place for people who want to be alone, but need company for it." — Alfred Polgar</p>
				<p class="text-sm text-on-surface-variant leading-relaxed">We explore the sociological impact of the 'third space' and how digital nomadic life is reshaping the aesthetic and function of the world's most historic coffee houses.</p>
				<button class="border-2 border-primary text-primary px-8 py-3 text-xs font-bold uppercase tracking-widest rounded hover:bg-primary hover:text-white transition-all duration-300">Read Essay</button>
			</div>
		</section>
	</div>
</MainLayout>
